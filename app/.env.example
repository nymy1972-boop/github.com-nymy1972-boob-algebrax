# ── Supabase (Project Settings → API Keys) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx   # pública por diseño (RLS la protege)
SUPABASE_URL=https://xxxx.supabase.co                      # la misma URL, lado servidor
SUPABASE_SECRET_KEY=sb_secret_xxxx                          # SOLO servidor — jamás NEXT_PUBLIC_

# ── Hotmart (Herramientas → Webhook, dentro del producto) ───────────────────
HOTMART_HOTTOK=

# ── Email transaccional (Resend, dominio propio verificado) ────────────────
RESEND_API_KEY=
EMAIL_FROM=hola@tudominio.com

# ── URL pública del sitio (para armar enlaces en los correos) ──────────────
# En Vercel no hace falta: usa VERCEL_URL automático. Ponla solo si el dominio
# final es distinto (ej. dominio propio en vez de *.vercel.app).
NEXT_PUBLIC_SITE_URL=

# ── IA — explicación del error en la práctica (DeepSeek, api.deepseek.com) ─
# SOLO servidor — nunca NEXT_PUBLIC_. Si queda vacía, la app usa el texto fijo
# de repuesto y sigue funcionando normal (nunca bloquea al estudiante).
DEEPSEEK_API_KEY=
AI_MODEL_DEEPSEEK=deepseek-chat

# ── Backoffice (panel de administración, solo dueño) ────────────────────────
# NO es secreto — es el correo verificado en el servidor que puede entrar a /admin.
ADMIN_EMAIL=

# ── Cron de recordatorios (racha en riesgo, ver vercel.json) ───────────────
# Secreto que protege /api/cron/recordatorios — generar uno propio (cualquier
# cadena larga aleatoria) y poner el MISMO valor en Vercel → Project Settings →
# Environment Variables. Vercel lo manda automático como Bearer en cada cron.
CRON_SECRET=
